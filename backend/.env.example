# ----------------------------------------------------------------------------
# Enterprise AI Intelligence Platform — environment template.
# Copy to backend/.env and fill in. NEVER commit real secrets.
# ----------------------------------------------------------------------------

# --- Core
ENVIRONMENT=dev
DEBUG=false
API_V1_PREFIX=/api/v1
# Comma-separated list (JSON array) of allowed frontend origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database
# SQLite for local dev; switch to a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///./enterprise_ai.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/eaip

# --- Auth / JWT  (CHANGE in production!)
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Vector store
# "chroma" (embedded, no server) | "pgvector" | "pinecone"
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_PATH=./chroma_db
CHROMA_COLLECTION=enterprise_documents
# PINECONE_API_KEY=
# PINECONE_ENV=
# PINECONE_INDEX=

# --- LLM providers
# Primary + fallback. Fallback is used automatically on rate-limit/error.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# Google Gemini - FREE at https://aistudio.google.com/apikey
GEMINI_API_KEY=Your gemini api key here
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Groq - FREE at https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# Local Ollama fallback (optional, for fully offline runs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Web Search (SerpAPI — used by the web_search agent tool)
# Get a free API key at https://serpapi.com/
SERPAPI_API_KEY=api key here
SERPAPI_URL=https://serpapi.com/search

# --- Embeddings
# "openai" | "huggingface" | "ollama"
# all-MiniLM-L6-v2: fast, 384-dim, runs on CPU, no API key required.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=20
# semantic | hybrid | rerank | rewrite
RETRIEVAL_STRATEGY=hybrid
MIN_RELEVANCE_SCORE=0.25
ANSWER_CONFIDENCE_THRESHOLD=0.35

# --- Agent
AGENT_MAX_ITERATIONS=8
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_TOKENS=1500

# --- Memory
MEMORY_MAX_MESSAGES=10

# --- Async processing
MAX_CONCURRENT_DOC_JOBS=2

# --- Caching (cost optimisation)
ENABLE_RESPONSE_CACHE=true
CACHE_MAX_ENTRIES=500

# --- Frontend (Next.js)
# Set to the deployed backend URL for production builds.
# NEXT_PUBLIC_API_URL=http://localhost:8000

